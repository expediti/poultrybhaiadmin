# Supabase Configuration for Poultry Bhai Admin Panel
# Connects to the EXACT SAME Supabase instance as the customer website
# Find these in Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Authorized Single Admin Email (Owner Access)
# Only this specific email address will be permitted to access the admin panel
VITE_ADMIN_EMAIL=owner@poultrybhai.com
